//  reverse an array 
import java.util.*;
class Main {
    public static void reverse(int a[],int n)
    {
        int start=0;
        int end =n-1;
        
        while(start<end)
        {
            int temp;
            temp = a[start];
            a[start] = a[end];
            a[end] = temp;
            start ++;
            end --;
        }
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in) ;
        int a [] = new int[20];
        int n;
        int key, res;
        System.out.println("enter size ");
        n = sc.nextInt();
        
        for(int i=0; i<n; i++)
        {
            System.out.println("Enter ");
            a[i] = sc.nextInt();
        }
         reverse( a,n);
        for(int i=0; i<n; i++)
        {
            System.out.println(a[i]);
            
        }
    }
}
