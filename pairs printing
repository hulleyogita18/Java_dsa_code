//  pairs printing  
import java.util.*;
class Main {
    public static void printPair(int a[],int n)
    {
        int total=0;
        for(int i=0; i<n; i++)
        {
            int curr = a[i];
            for(int j=i+1; j<n; j++)
            {
                System.out.print( "(" +curr+ "," +a[j]+ ")");
                total++;
            }
            System.out.println();
        }
        System.out.println("Total pairs: "+total);
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in) ;
        int a [] = new int[20];
        int n;
        int key, res;
        System.out.println("enter size ");
        n = sc.nextInt();
        
        for(int i=0; i<n; i++)
        {
            System.out.println("Enter ");
            a[i] = sc.nextInt();
        }
         printPair( a,n);
    }
}
// T.C. = O( n^2)
// n(n-1)/2
