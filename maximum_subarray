//max  sub array
class Main {
    public static void subArrays(int number[])
    {
        int maxSum=Integer.MIN_VALUE;
        int currSum=0;
        for(int i=0; i<number.length; i++)
        {
           
            int start = i;
            for(int j=i; j<number.length; j++)
            {
                int end = j;
                 currSum=0;
                for(int k=start; k<=end; k++)
                {
                    currSum+= number[k];
                }
                if(maxSum < currSum)
                {
                    maxSum = currSum;
                }
            }
            System.out.println(" ");
        }
        System.out.println("maximum sub arrys "+maxSum);    
    }
    public static void main(String[] args) {
        int num[] ={10,20,30,5,2};
        subArrays(num);
    }
}
