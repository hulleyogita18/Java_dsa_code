
// sub array
class Main {
    public static void subArrays(int number[])
    {
        int t=0;
        int sum=0;
        for(int i=0; i<number.length; i++)
        {
            int start = i;
            for(int j=i; j<number.length; j++)
            {
                int end = j;
                for(int k=start; k<=end; k++)
                {
                    System.out.print(number[k]+ " ");
                }
                t++;    // total sub arrays
                System.out.println(" ");
            }
            System.out.println(" ");
        }
        System.out.println("total sub arrys "+t);    
    }
    public static void main(String[] args) {
        // System.out.println(" ");
        int num[] ={10,20,30,5,2};
        subArrays(num);
    }
}
